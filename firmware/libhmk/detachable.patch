diff --git a/src/matrix.c b/src/matrix.c
index 6d4d823..bb5dca3 100644
--- a/src/matrix.c
+++ b/src/matrix.c
@@ -48,7 +48,96 @@ key_state_t key_matrix[NUM_KEYS];
 // Bitmap for tracking which keys have Rapid Trigger disabled
 static bitmap_t rapid_trigger_disabled[] = MAKE_BITMAP(NUM_KEYS);
 
-void matrix_init(void) { matrix_recalibrate(false); }
+// Reset a key to the initial calibration values, released
+static void matrix_reset_key(uint32_t i) {
+  key_matrix[i].adc_filtered = eeconfig->calibration.initial_rest_value;
+  key_matrix[i].adc_rest_value = eeconfig->calibration.initial_rest_value;
+  key_matrix[i].adc_bottom_out_value =
+      matrix_bottom_out_value(i, eeconfig->calibration.initial_rest_value);
+  key_matrix[i].distance = 0;
+  key_matrix[i].extremum = 0;
+  key_matrix[i].key_dir = KEY_DIR_INACTIVE;
+  key_matrix[i].is_pressed = false;
+}
+
+// One calibration step of a key: filter the ADC value and lower the rest value
+static void matrix_calibrate_key(uint32_t i) {
+  const uint16_t new_adc_filtered =
+      EMA(matrix_analog_read(i), key_matrix[i].adc_filtered);
+
+  key_matrix[i].adc_filtered = new_adc_filtered;
+
+  if (new_adc_filtered + MATRIX_CALIBRATION_EPSILON <=
+      key_matrix[i].adc_rest_value)
+    // Only update the rest value if the new value is smaller and the
+    // difference is at least the calibration epsilon
+    key_matrix[i].adc_rest_value = new_adc_filtered;
+
+  // Update the bottom-out value to be the minimum bottom-out value based on
+  // the updated rest value
+  key_matrix[i].adc_bottom_out_value =
+      matrix_bottom_out_value(i, key_matrix[i].adc_rest_value);
+}
+
+#if defined(DETACHABLE_KEYS)
+// Keys on a detachable part of the keyboard, e.g. the other half of a split
+// keyboard joined by a cable. While the part is detached, its keys are held
+// released and their ADC values are ignored: the inputs float, and a stray
+// value would press keys or corrupt the learned bottom-out values. When it is
+// attached again, its keys are calibrated afresh for
+// `MATRIX_CALIBRATION_DURATION` while the rest of the keyboard keeps working.
+static const uint8_t detachable_keys[] = DETACHABLE_KEYS;
+static bitmap_t detachable[] = MAKE_BITMAP(NUM_KEYS);
+
+typedef enum {
+  DETACHABLE_DETACHED = 0,
+  DETACHABLE_CALIBRATING,
+  DETACHABLE_ATTACHED,
+} detachable_state_t;
+
+static detachable_state_t detachable_state = DETACHABLE_ATTACHED;
+static uint32_t detachable_attach_time = 0;
+
+static void detachable_detach(void) {
+  detachable_state = DETACHABLE_DETACHED;
+  for (uint32_t i = 0; i < M_ARRAY_SIZE(detachable_keys); i++)
+    matrix_reset_key(detachable_keys[i]);
+}
+
+// Follow the detect pin. Detaching takes effect at once; every new attachment
+// (including contact bounce while plugging in) restarts the calibration.
+static void detachable_task(void) {
+  if (!analog_detachable_attached()) {
+    if (detachable_state != DETACHABLE_DETACHED)
+      detachable_detach();
+  } else if (detachable_state == DETACHABLE_DETACHED) {
+    detachable_state = DETACHABLE_CALIBRATING;
+    detachable_attach_time = timer_read();
+  } else if (detachable_state == DETACHABLE_CALIBRATING &&
+             timer_elapsed(detachable_attach_time) >=
+                 MATRIX_CALIBRATION_DURATION)
+    detachable_state = DETACHABLE_ATTACHED;
+}
+
+// Whether the scan should skip a key: it is on the detachable part, and the
+// part is detached or still calibrating
+__attribute__((always_inline)) static inline bool
+detachable_skip(uint32_t i) {
+  if (detachable_state == DETACHABLE_ATTACHED || !bitmap_get(detachable, i))
+    return false;
+  if (detachable_state == DETACHABLE_CALIBRATING)
+    matrix_calibrate_key(i);
+  return true;
+}
+#endif
+
+void matrix_init(void) {
+#if defined(DETACHABLE_KEYS)
+  for (uint32_t i = 0; i < M_ARRAY_SIZE(detachable_keys); i++)
+    bitmap_set(detachable, detachable_keys[i], true);
+#endif
+  matrix_recalibrate(false);
+}
 
